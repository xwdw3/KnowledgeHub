# ============ P3 部署环境变量模板 ============
# 用法：cp .env.example .env 后填入真实值；.env 不要提交到版本库
#
# 本模板按「必须改」→「按需改」排序：带 ★ 的项目上线前必须填写，
# 其余保持默认即可（默认值都是安全且经过验收的）。

# ---- 服务 ----
ENV=prod
LOG_LEVEL=INFO
# 结构化日志格式：json（容器/采集）| text（本地排查）
LOG_FORMAT=json
API_PORT=8012

# ---- 业务库 ----
# ★ PG_PASSWORD 必须改
PG_USER=raguser
PG_PASSWORD=change_me
PG_DB=rag_db

# ---- 模型 ----
MODEL_MODE=auto
# ★ 两个密钥至少填一个来源；auto 模式下缺任一者会退化为 offline 确定性模型
EMBED_API_KEY=
CHAT_API_KEY=

# ---- 鉴权：API Key（脚本/服务间调用）----
AUTH_ENABLED=true
# ★ 认证模式
#   jwt：只认 JWT。除登录/刷新/健康检查/文档外，所有接口必须带 JWT Token；
#        API Key 只能 POST /api/v1/auth/token 换取 token，不能直接访问业务接口。
#   any：P2 兼容模式，API Key 可直接当 Bearer 用（仅限存量集成未改造完时短期开启）。
AUTH_MODE=jwt
# 留空则每次启动随机生成并打印到日志；生产建议固定，避免重建后脚本全部失效
BOOTSTRAP_ADMIN_KEY=
# /metrics 抓取令牌：与 JWT 独立（Prometheus 无法执行登录流程），只读、可单独轮换。
# 留空则自动生成并持久化到数据卷。同时需写入 deploy/prometheus/metrics_token 文件。
METRICS_TOKEN=
# false 表示 /metrics 完全免认证（仅在纯内网调试时使用）
METRICS_PROTECTED=true
# /dashboard 是空壳页（不含数据），默认公开；数据由浏览器带 token 拉取
DASHBOARD_PUBLIC=true

# ---- 鉴权：JWT（人登录）----
JWT_ENABLED=true
# ★ 生产建议显式指定；留空则由容器首次启动生成并持久化到数据卷（重建不失效）
JWT_SECRET=
JWT_ACCESS_TTL=1800
JWT_REFRESH_TTL=604800
JWT_BLACKLIST_ENABLED=true
BOOTSTRAP_ADMIN_USER=admin
# ★ 初始管理员密码，首次登录后请立即修改
#    长度建议 >= 12 位，含大小写、数字、符号
BOOTSTRAP_ADMIN_PASSWORD=

# ---- 知识库空间（多租户隔离）----
DEFAULT_SPACE_ID=default
DEFAULT_SPACE_NAME=默认空间

# ---- 限流（固定窗口）----
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=120
RATE_LIMIT_WINDOW_SEC=60
# 语法：路径前缀=次数，逗号分隔；更长前缀优先匹配
RATE_LIMIT_RULES=/api/v1/chat=30,/api/v1/documents=20,/api/v1/auth/login=10,/metrics=600

# ---- 缓存 ----
CACHE_ENABLED=true
REDIS_MAXMEMORY=256mb
CACHE_TTL_RETRIEVAL=300
CACHE_TTL_ANSWER=600
# 对话上下文缓存（Redis），单位秒
CACHE_TTL_CONTEXT=1800

# ---- 检索与重排 ----
# llm：用大模型打分（效果最好，多一次调用）；heuristic：本地启发式（零成本）；
# off：不重排，回归 P2 行为
RERANK_MODE=llm
RERANK_CANDIDATES=10
RERANK_TIMEOUT_SEC=12
# 答案溯源阈值：低于该相关度直接拒答，避免编造
MIN_SCORE=0.25

# ---- 审计与监控 ----
AUDIT_ENABLED=true
METRICS_ENABLED=true
# Grafana 宿主机端口与登录（匿名只读默认开启，便于演示）
GRAFANA_PORT=3000
GRAFANA_ANONYMOUS=true
GRAFANA_USER=admin
# ★ 生产必须改
GRAFANA_PASSWORD=change_me

# ---- 外网模型 API 代理 ----
# 仅当模型 API 需要经代理访问时填写（容器内需用 host.docker.internal 回指宿主机）
HTTP_PROXY=
HTTPS_PROXY=
