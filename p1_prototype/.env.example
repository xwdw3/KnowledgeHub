# ========== P1 原型配置 ==========
# 说明：本文件只放非敏感配置，密钥统一从项目根目录 .env 读取

# ---------- 向量模型（硅基流动 BGE-M3）----------
EMBED_MODEL_NAME=BAAI/bge-m3
EMBED_DIM=1024

# ---------- 生成模型（DeepSeek）----------
CHAT_MODEL=deepseek-flash

# ---------- 切片 ----------
CHUNK_SIZE=450
CHUNK_OVERLAP=80

# ---------- 检索 ----------
# 向量/BM25 各自召回条数
RECALL_K=10
# RRF 平滑常数（融合双路排名）
RRF_K=60
# 最终进入上下文的片段数
FINAL_TOP_K=3
# 相关度阈值：低于该值视为"无答案"
MIN_SCORE=0.25

# ---------- 演示模式 ----------
# auto: 有密钥调真实模型，无密钥自动降级为本地离线模式（不消耗额度，可演示全链路）
DEMO_MODE=auto

# ---------- 服务 ----------
HOST=0.0.0.0
PORT=8011
